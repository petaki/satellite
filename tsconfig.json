{
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "lib": ["DOM", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "paths": { "@/*": ["./resources/js/*"] },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["vite/client"],
        "useDefineForClassFields": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "resources/js/**/*.d.ts",
        "vite.config.ts"
    ],
    "vueCompilerOptions": {
        "strictTemplates": true
    }
}
